# --- API KEYS ---
# Google Earth Engine (GEE)
EE_PROJECT_ID=your_project_id_here
# NASA FIRMS API Key (Get from: https://firms.modaps.eosdis.nasa.gov/api/config/)
FIRMS_API_KEY=your_firms_key_here
# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- APP CONFIG ---
LOG_LEVEL=INFO
CHECK_INTERVAL_SECONDS=3600
MONITOR_LAT=35.6892
MONITOR_LON=51.3890
RADIUS_DEG=0.5
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
